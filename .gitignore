.idea

# Node
node_modules/
dist/
dist-electron/
*.log

# Python
backend/venv/
__pycache__/
.venv
*.pyc

# Electron / packaging build output — all regenerated by `npm run dist`
# and the PyInstaller/Inno Setup build steps, never source code
out/
release/
installer_output/
backend/build/
backend/dist/

# Bundled native resources — copied in locally per the build steps,
# never committed (Tesseract, Poppler, GTK3 runtime, Ollama + models,
# the PyInstaller-built backend)
resources/

# Env files
.env
.env.local

# Runtime data — the actual working database and every document the
# app generates at runtime, never source code
backend/docgen.db
backend/generated_files/*
backend/uploaded_documents/*
backend/received_documents/*
